{
  "name": "noted-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply noted-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply noted-db --remote",
    "import:local": "node scripts/import-local-state.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.124.0"
  }
}
