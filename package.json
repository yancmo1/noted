{
  "name": "noted",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "dev:api:local": "LLM_MODE=real LLM_BASE_URL=http://127.0.0.1:11434/v1 LLM_API_KEY=ollama LLM_MODEL=gpt-oss:20b node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -b && vite build --config apps/web/vite.config.ts",
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file-if-exists=.env --import tsx apps/api/src/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "fastify": "^5.2.1",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitest/coverage-v8": "^3.0.7",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}
