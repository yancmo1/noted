[Unit]
Description=Noted ai-lab Whisper small.en transcriber
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yancy
WorkingDirectory=/home/yancy/transcribe
EnvironmentFile=/home/yancy/transcribe/transcriber.env
ExecStart=/home/yancy/transcribe/.venv/bin/python /home/yancy/transcribe/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
