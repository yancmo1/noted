PORT=3333
APP_URL=http://localhost:5173
# Leave empty for same-origin/Vite-proxy development. Set this to the Mac's
# HTTPS Tailscale Serve URL when the web UI is hosted elsewhere.
VITE_API_BASE_URL=
DATA_DIR=./storage
AUTH_PASSWORD=memory
# Reasoning / Ask / meeting analysis provider. Reuses the Groq transcription key when LLM_API_KEY is empty.
LLM_MODE=real
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
# Set these only for bounded local analysis; zero preserves one-request behavior.
LLM_ANALYSIS_CHUNK_CHARS=0
LLM_ANALYSIS_TIMEOUT_MS=0

# Transcription runs on the YNUC ai-lab VM through its OpenAI-compatible local endpoint.
TRANSCRIPTION_PROVIDER=ai-lab
TRANSCRIPTION_MODE=real
TRANSCRIPTION_BASE_URL=http://127.0.0.1:8787/v1
TRANSCRIPTION_API_KEY=replace-with-ai-lab-service-key
TRANSCRIPTION_MODEL=large-v3
TRANSCRIPTION_MAX_MB=20
TRANSCRIPTION_CHUNK_SECONDS=120

# The local tracer overrides TRANSCRIPTION_PROVIDER with local-whisper and
# invokes the existing Apple Silicon Whisper.cpp wrapper on the Mac.
LOCAL_WHISPER_WRAPPER=/Users/yancyshepherd/Library/Application Support/Noted/transcription/bin/noted-transcribe
LOCAL_WHISPER_MODEL=ggml-large-v3-turbo-q5_0
LOCAL_WHISPER_OUTPUT_DIR=./storage/local-transcription
LOCAL_WHISPER_TIMEOUT_MS=1800000
LOCAL_WHISPER_LANGUAGE=auto

# Legacy AI_* names remain supported for existing installations.
AI_MODE=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
MAX_UPLOAD_MB=256
