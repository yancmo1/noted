PORT=3333
APP_URL=http://localhost:5173
DATA_DIR=./storage
AUTH_PASSWORD=memory
# Reasoning / Ask / meeting analysis provider. Use mock for deterministic local tests.
LLM_MODE=mock
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# Transcription provider. Groq is the default provider abstraction.
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_MODE=real
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_MAX_MB=20
TRANSCRIPTION_CHUNK_SECONDS=600

# Legacy AI_* names remain supported for existing installations.
AI_MODE=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
MAX_UPLOAD_MB=256
